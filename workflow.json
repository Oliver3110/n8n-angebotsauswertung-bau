        "jsonSchemaExample": "{\n  \"anbieter\": \"Muster Bau GmbH\",\n  \"datum\": \"2026-09-01\",\n  \"projekt\": \"Neubau Lagerhalle\",\n  \"positionen\": [\n    {\n      \"leistung\": \"Erdarbeiten\",\n      \"preis\": 12500.0\n    }\n  ],\n  \"gesamtpreis\": 12500.0,\n  \"hinweise\": \"Ausführung KW 40 bis 44, Entsorgung nicht enthalten\"\n}",
