    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const bin = item.binary || {};\n  const key = Object.keys(bin).find((k) => {\n    const fn = String(bin[k].fileName || '').toLowerCase();\n    const dir = String(bin[k].directory || '').toLowerCase();\n    return fn === 'document.xml' && (dir === '' || dir.includes('word'))\n      || fn.endsWith('word/document.xml');\n  });\n  if (!key) continue;\n  out.push({ json: item.json || {}, binary: { data: bin[key] } });\n}\nreturn out;",
        "notice": ""
      },
