    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const toIsoDate = (v) => {\n  const s = String(v || '').trim();\n  if (/^\\d{4}-\\d{2}-\\d{2}/.test(s)) return s.slice(0, 10);\n  const m = s.match(/^(\\d{1,2})\\.(\\d{1,2})\\.(\\d{2,4})$/);\n  if (m) {\n    const y = m[3].length === 2 ? '20' + m[3] : m[3];\n    return y + '-' + m[2].padStart(2, '0') + '-' + m[1].padStart(2, '0');\n  }\n  return '';\n};\nconst euro = (n) => (typeof n === 'number' ? n.toLocaleString('de-DE', { style: 'currency', currency: 'EUR' }) : 'Preis unklar');\n\nconst out = [];\nfor (const item of $input.all()) {\n  const o = item.json.output || {};\n  const hatPositionen = Array.isArray(o.positionen) && o.positionen.length > 0;\n  const positionen = hatPositionen\n    ? o.positionen\n    : [{ leistung: 'Pauschalangebot (keine Einzelpositionen)', preis: typeof o.gesamtpreis === 'number' ? o.gesamtpreis : null }];\n  for (const p of positionen) {\n    out.push({\n      json: {\n        anbieter: o.anbieter || 'unbekannt',\n        datum: toIsoDate(o.datum),\n        projekt: o.projekt || '',\n        leistung: p.leistung || '',\n        preis: typeof p.preis === 'number' ? p.preis : null,\n        position_text: (p.leistung || 'ohne Bezeichnung') + ': ' + euro(p.preis),\n        gesamtpreis: typeof o.gesamtpreis === 'number' ? o.gesamtpreis : null,\n        hinweise: o.hinweise || '',\n      },\n    });\n  }\n}\nreturn out;",
        "notice": ""
      },
