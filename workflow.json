      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return $input.all().map((item) => {\n  const xml = String(item.json.xml || '');\n  const text = xml\n    .replace(/<\\/w:p>/g, '\\n')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/[ \\t]{2,}/g, ' ')\n    .replace(/\\n{2,}/g, '\\n')\n    .trim();\n  return { json: { datei_name: item.json.datei_name, datei_typ: item.json.datei_typ, text: text } };\n});",
        "notice": ""
      },
