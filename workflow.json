      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const out = [];\nfor (const item of $('Angebote hochladen').all()) {\n  const bin = item.binary || {};\n  for (const key of Object.keys(bin)) {\n    const b = bin[key];\n    const name = b.fileName || key;\n    const ext = String(b.fileExtension || name.split('.').pop() || '').toLowerCase();\n    let typ = 'unbekannt';\n    if (ext === 'pdf') typ = 'pdf';\n    else if (ext === 'docx') typ = 'docx';\n    else if (['png', 'jpg', 'jpeg', 'webp', 'heic', 'tif', 'tiff'].includes(ext)) typ = 'bild';\n    // DOCX ist technisch ein ZIP-Archiv. Der Node 'DOCX entpacken' erkennt es nur an der Endung .zip\n    const data = typ === 'docx'\n      ? { ...b, fileExtension: 'zip', mimeType: 'application/zip', fileName: name + '.zip' }\n      : b;\n    out.push({ json: { datei_name: name, datei_typ: typ }, binary: { data } });\n  }\n}\nreturn out;",
        "notice": ""
      },
      "name": "Dateien aufteilen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
