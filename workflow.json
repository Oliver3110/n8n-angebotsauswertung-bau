    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return $input.all().map((item) => {\n  const j = item.json || {};\n  let text = j.text || j.content || j.xml || '';\n  if (Array.isArray(text)) text = text.join('\\n');\n  if (text && typeof text === 'object') text = JSON.stringify(text);\n  let name = j.datei_name;\n  let typ = j.datei_typ;\n  if (!name) {\n    try {\n      const src = $('Dateien aufteilen').item.json;\n      name = src.datei_name;\n      typ = src.datei_typ;\n    } catch (e) {}\n  }\n  return { json: { datei_name: name || 'unbekannt', datei_typ: typ || 'unbekannt', text: String(text).slice(0, 20000) } };\n});",
        "notice": ""
      },
      "name": "Text vereinheitlichen",
